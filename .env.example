# Standalone presentation defaults: no AeroPulse backend is required.
NEXT_PUBLIC_AEROPULSE_DEMO_MODE=true
NEXT_PUBLIC_AEROPULSE_MAP_MODE=demo

# Optional, server-only CARTO basemap credential. Obtain a key from your CARTO account.
# Never rename this to a NEXT_PUBLIC_ variable.
# CARTO_BASEMAP_API_KEY=replace-with-your-carto-key
